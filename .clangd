CompileFlags:
  Add:
    - -I/usr/local/cuda/include
    - -I/usr/local/cuda-13.2/targets/x86_64-linux/include/cccl
    - -I/home/hz/miniforge3/envs/cuda/include/python3.12
    - -I/home/hz/miniforge3/envs/cuda/lib/python3.12/site-packages/pybind11/include
    - -I/usr/include
    - -I/usr/include/c++/13
    - -I/usr/include/x86_64-linux-gnu/c++/13
    - -std=c++17
    - --cuda-gpu-arch=sm_120
  Remove:
    - -forward-unknown-to-host-compiler
    - --generate-code*
    - -Xcompiler*
    - -Xcudafe*

InlayHints:
  Enabled: true
  ParameterHints: true
  DeducedTypes: true

---
If:
  PathMatch: python/.*
CompileFlags:
  Add:
    - -DPYBIND11_DETAILED_ERROR_MESSAGES
    - -fPIC
