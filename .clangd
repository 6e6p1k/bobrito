# Prefer compile_commands.json (run: ./bobr configure).
# Fallback flags when the compilation database is missing.
CompileFlags:
  Add:
    - -std=c++17
    - -Isrc
    - --cuda-path=.venv/cuda
    - -isystem.venv/cuda/include/cccl
    - --cuda-gpu-arch=sm_120
  Remove:
    - -forward-unknown-to-host-compiler
    - --generate-code*
    - -Xcompiler*
    - -Xcudafe*
  CompilationDatabase: .

# clangd 23 ignores --clang-tidy-checks; readability-* lives here.
Diagnostics:
  # CUDA 13 CCCL headers trip this under clang; not our code.
  Suppress:
    - deduction_guide_target_attr
  ClangTidy:
    Remove:
      - "*"
    Add:
      - readability-*

InlayHints:
  Enabled: true
  ParameterNames: true
  DeducedTypes: true

---
# .cuh headers borrow a .cpp command (-x c++-header); force CUDA mode.
If:
  PathMatch: .*\.cuh
CompileFlags:
  Add:
    - -xcuda
