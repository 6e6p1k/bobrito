{
  "version": 2,
  "groups": [
    {
      "id": "setup",
      "label": "Setup",
      "description": "First-time setup and health checks",
      "actions": [
        {
          "id": "install-cuda",
          "label": "Install CUDA deps",
          "description": "CUDA 13 toolkit as pip wheels into .venv/cuda",
          "bobr": ["install-cuda"]
        },
        {
          "id": "install-cuda-check",
          "label": "Check CUDA deps",
          "bobr": ["install-cuda", "--check"],
          "description": "Verify the CUDA libraries only"
        },
        {
          "id": "install",
          "label": "Install dependencies",
          "description": "Create .venv with torch, pybind11 and the CUDA 13 toolkit",
          "bobr": ["install"]
        },
        {
          "id": "configure-cuda",
          "label": "Configure CUDA paths",
          "description": "Point the build at the .venv toolkit",
          "bobr": ["configure-cuda"]
        },
        {
          "id": "configure",
          "label": "Configure IDE (clangd)",
          "description": "Generate compile_commands.json for clangd",
          "bobr": ["configure"]
        },
        {
          "id": "doctor",
          "label": "Doctor",
          "description": "CUDA, Python, extension and IDE checks",
          "bobr": ["doctor"]
        }
      ]
    },
    {
      "id": "build",
      "label": "Extension",
      "description": "Link everything into python/bobrito, or start from a clean build",
      "actions": [
        {
          "id": "build-python",
          "label": "Rebuild Python lib",
          "description": "Full extension build, copied to python/",
          "bobr": ["build", "python"]
        },
        {
          "id": "build-clean",
          "label": "Clean all",
          "bobr": ["build", "clean"],
          "variant": "destructive",
          "description": "Delete all build outputs"
        }
      ]
    },
    {
      "id": "test",
      "label": "Official suites",
      "description": "See docs/DEV.md",
      "actions": [
        {
          "id": "test-smoke",
          "label": "Smoke tests",
          "description": "Gradient checks against torch (test_gradients.py)",
          "bobr": ["test", "smoke"]
        },
        {
          "id": "test-full",
          "label": "Full tests",
          "description": "Smoke plus ops vs torch, shapes, advanced ops, general_test and new_test",
          "bobr": ["test", "full"]
        }
      ]
    },
    {
      "id": "cpp-tests",
      "label": "C++ (legacy)",
      "description": "Makefile test targets",
      "actions": [
        {
          "id": "run-general-test",
          "label": "general_test",
          "bobr": ["make", "run_gen_test"],
          "description": "Builds and runs tests/general_test.cpp"
        },
        {
          "id": "run-mem-leak-test",
          "label": "memory_leak_test",
          "bobr": ["make", "run_mem_leak_test"],
          "description": "Builds and runs tests/memory_leak_test.cpp"
        }
      ]
    },
    {
      "id": "debug",
      "label": "Debug scripts",
      "description": "Ad-hoc, not part of the official suites",
      "actions": [
        {
          "id": "debug-loss",
          "label": "debug_loss.py",
          "bobr": ["run-script", "debug_loss.py"],
          "description": "Runs debug_loss.py with the venv Python"
        },
        {
          "id": "nvidia-smi",
          "label": "nvidia-smi",
          "bobr": ["exec", "nvidia-smi"],
          "description": "GPU, driver and memory usage"
        },
        {
          "id": "nvcc-version",
          "label": "nvcc --version",
          "bobr": ["exec", "nvcc", "--version"],
          "description": "The nvcc on PATH, which may differ from the build toolkit"
        }
      ]
    }
  ]
}
